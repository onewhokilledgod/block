{
	"manifest_version": 3,
	"name": "Block browser E2E",
	"version": "0.0.1",
	"description": "Temporary test build for real-browser integration tests.",
	"host_permissions": ["http://127.0.0.1/*"],
	"permissions": ["activeTab", "declarativeNetRequest", "scripting"],
	"declarative_net_request": {
		"rule_resources": [
			{
				"id": "startup_compatibility",
				"enabled": true,
				"path": "rules/startup-compatibility.json"
			}
		]
	},
	"background": {
		"service_worker": "background.js",
		"scripts": ["background.js"],
		"type": "module"
	},
	"content_scripts": [
		{
			"matches": ["http://127.0.0.1/*"],
			"js": ["e2e-ready.js", "content.js"],
			"run_at": "document_idle"
		}
	],
	"content_security_policy": {
		"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
	}
}
